{
  "name": "boid-wasm-sim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --filter @boid-wasm-sim/hooks build && pnpm --filter @boid-wasm-sim/components build && pnpm --filter @boid-wasm-sim/wasm build && pnpm --filter @boid-wasm-sim/web build:only",
    "preview": "pnpm --filter @boid-wasm-sim/web preview",
    "clean": "pnpm --recursive clean",
    "test": "pnpm --filter @boid-wasm-sim/components test && pnpm --filter @boid-wasm-sim/web test",
    "test:all": "pnpm test && pnpm --filter @boid-wasm-sim/wasm test",
    "mutation": "pnpm mutation:go && pnpm mutation:ts",
    "mutation:ts": "pnpm --filter @boid-wasm-sim/hooks mutation && pnpm --filter @boid-wasm-sim/components mutation",
    "mutation:go": "pnpm --filter @boid-wasm-sim/wasm mutation",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "typescript": "catalog:"
  }
}
